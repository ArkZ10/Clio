# Copy to `.env` and fill in real values. `.env` is gitignored -- never commit
# real keys or machine-specific paths. This template documents the vars only.

# Absolute path to the Obsidian vault Clio reads. READ-ONLY: the backend never
# writes to it. Required by the /vault/* endpoints -- when unset or pointing at
# a directory that does not exist, those endpoints return 503 with a clear
# message (everything else keeps working).
# e.g. CLIO_VAULT_PATH=/media/yeftha10/Data/clio
CLIO_VAULT_PATH=

# Where the FastAPI backend binds. Both optional -- defaults shown.
# CLIO_HOST=0.0.0.0
# CLIO_PORT=8000

# LLM provider keys used by the parked SQLite pipeline (scripts/). Only needed
# if you run those jobs; the vault graph does not use them.
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
# OLLAMA_MODEL=qwen3:4b
