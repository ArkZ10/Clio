# Copy to `web/.env` and fill in real values. `web/.env` is gitignored --
# never commit real keys. This template documents required vars only.

# Base URL of the Clio FastAPI backend. Used by the vault graph AND by chat --
# all chat now goes to POST {VITE_API_URL}/vault/chat, which answers only from
# your vault via llm_switch. (The old Lovable AI gateway route and its
# LOVABLE_API_KEY were removed; the backend's DeepSeek key lives in the repo
# root .env, not here.)
# The VITE_ prefix is required: it is what exposes the value to browser code as
# import.meta.env.VITE_API_URL. Safe to expose -- it is a local URL, not a secret.
# The dev server runs on port 3000 to match the backend's CORS allow_origins.
VITE_API_URL=http://localhost:8000
