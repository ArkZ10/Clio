# Copy to `web/.env` and fill in real values. `web/.env` is gitignored --
# never commit real keys. This template documents required vars only.

# Lovable AI Gateway key, used SERVER-SIDE ONLY by the /api/chat route
# (web/src/routes/api/chat.ts). Sent as the `Lovable-API-Key` header from
# web/src/lib/ai-gateway.server.ts. Without it, POST /api/chat returns
# 500 "Missing LOVABLE_API_KEY".
# Note: no VITE_/PUBLIC_ prefix -- this must NOT be exposed to the browser.
LOVABLE_API_KEY=
